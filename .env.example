# Drishti Assistive Wearable: Environment Configuration
# Copy this file to .env and insert your API key:
#   cp .env.example .env

# Online Vision API Key (Supports OpenAI or Google Gemini)
# Provide at least ONE of the following:
OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: Vision Provider Override ('openai' or 'gemini', auto-detected if empty)
DRISHTI_VISION_PROVIDER=

# Optional: Model Selection Override
# Defaults:
#   OpenAI: gpt-4o-mini
#   Gemini: gemini-3.1-flash-lite
DRISHTI_VISION_MODEL=

# Caregiver MQTT Telemetry Credentials (Optional)
DRISHTI_MQTT_USERNAME=
DRISHTI_MQTT_PASSWORD=
